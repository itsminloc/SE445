# ==========================================================
# SE445 ORI (Omnichannel Retail Integration) - Env Template
# Local Development & Docker Compose (Zero Secrets in Git)
# ==========================================================

NODE_ENV=development
LOG_LEVEL=info

# Service Ports
GATEWAY_PORT=8080
KONG_PORT=8000
ORDER_PORT=3004
WMS_PORT=3001
CRM_PORT=3002
TMS_PORT=3003

# PostgreSQL (4 Logical Databases: order_db, wms_db, crm_db, tms_db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=caseuser
POSTGRES_PASSWORD=casepass_local_change_me
POSTGRES_DB=retail

# RabbitMQ (Topic Exchange: retail.events | DLX: retail.dlx)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=caseuser
RABBITMQ_PASSWORD=casepass_local_change_me
RABBITMQ_URL=amqp://caseuser:casepass_local_change_me@localhost:5672

# Downstream System URLs (Override with Docker service names in compose)
WMS_BASE_URL=http://localhost:3001
CRM_BASE_URL=http://localhost:3002
TMS_BASE_URL=http://localhost:3003

# Security & Gateway
JWT_SECRET=ori-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
RATE_LIMIT_MAX_PER_MIN=100
CORS_ORIGIN=*

# AI Data Mapping Assistant (Optional: falls back to deterministic parser if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
